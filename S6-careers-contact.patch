diff --git a/assets/css/pages/forms.css b/assets/css/pages/forms.css
new file mode 100644
index 0000000..eabf302
--- /dev/null
+++ b/assets/css/pages/forms.css
@@ -0,0 +1,94 @@
+/* career.html · apply.html · contact.html — owned by S6.
+   Uses tokens and components from site.css only (no new colours, no new typefaces).
+   Parts: 1 two-column page body · 2 side column · 3 the letter (form sheet) · 4 fields, picks, messages · 5 roles list · 6 small screens */
+
+/* 1 · two-column page body ------------------------------------------------- */
+.formpage{padding-bottom:clamp(4rem,8vw,7rem)}
+.formpage .grid{align-items:start;row-gap:clamp(2.5rem,6vw,4rem)}
+.apply-title{font-size:var(--s-4);max-width:14em}
+
+/* 2 · side column ("what to tell us", "about the role") -------------------- */
+.side>*+*{margin-top:1.4rem}
+.side__title{font-size:.74rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);line-height:1.3;
+  padding-bottom:.6rem;border-bottom:1px solid var(--ink)}
+.side__title:not(:first-child){margin-top:2.4rem}
+.side__mail{padding-top:.4rem}
+.side__mail .mail{display:inline-block;margin-top:.35rem;font-size:var(--s-2);font-weight:700;letter-spacing:-.012em;line-height:1.15;color:var(--ink);overflow-wrap:anywhere}
+.side__hubs{font-size:.95rem}
+.side__text{color:var(--ink-2);max-width:34em}
+/* lettered list: a. b. c. — same voice as the roman numerals on the studio page */
+.ask{counter-reset:ask;margin-top:.2rem!important}
+.ask li{counter-increment:ask;display:grid;grid-template-columns:2rem 1fr;gap:0 .6rem;padding:.85rem 0;border-bottom:1px solid var(--rule);color:var(--ink-2);line-height:1.45}
+.ask li::before{content:counter(ask,lower-alpha) ".";font-family:var(--mono);font-size:.82rem;color:var(--crimson);padding-top:.28em}
+.ask li small{grid-column:2;display:block;font-size:.88rem;font-style:italic;color:var(--ink-3)}
+
+/* 3 · the letter: a sheet of paper that holds the form --------------------- */
+.letter{position:relative;background:var(--paper-2);border:1px solid var(--rule);border-top:2px solid var(--ink);border-radius:var(--radius);
+  padding:clamp(1.3rem,3.2vw,2.4rem)}
+.letter__head{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.3rem 1.5rem;padding-bottom:1rem;border-bottom:1px solid var(--rule);
+  font-family:var(--mono);font-size:.78rem;color:var(--ink-3)}
+.letter__head b{font-weight:400;color:var(--ink);margin-left:.4em}
+.letter__date:empty{display:none}
+.letter__dear{display:block;font-size:var(--s-2);font-style:italic;font-weight:700;line-height:1.1;color:var(--ink)}
+.letter__close{margin-top:2rem;font-size:var(--s-1);font-style:italic;color:var(--ink)}
+.letter__send{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.4rem;margin-top:2rem}
+.letter__close+.letter__send{margin-top:1rem}
+.field--letter{margin-top:2.2rem}
+/* ruled writing paper for the message box */
+.field--letter textarea{--lh:1.8rem;min-height:calc(var(--lh)*7 + .2rem);padding:.2rem 0 0;line-height:var(--lh);margin-top:.8rem;
+  background-image:repeating-linear-gradient(to bottom,transparent 0,transparent calc(var(--lh) - 1px),var(--rule) calc(var(--lh) - 1px),var(--rule) var(--lh));
+  background-position:0 .2rem;background-attachment:local}
+
+/* 4 · fields, project-type picks, messages --------------------------------- */
+.field>span small,.pick-set legend small{margin-left:.5em;font-size:1em;font-weight:400;font-style:italic;letter-spacing:0;text-transform:none;color:var(--ink-3)}
+.field.is-invalid input,.field.is-invalid textarea{border-bottom-color:var(--crimson);box-shadow:0 1px 0 var(--crimson)}
+.field__err{margin-top:.45rem;font-size:.92rem;font-style:italic;line-height:1.35;color:var(--crimson)}
+.field__err::before{content:"\2020\00a0";font-style:normal}   /* † so the error is not signalled by colour alone */
+/* project type: radio inputs that look like set type, not pills */
+.pick-set{border:0;margin:1.8rem 0 0;padding:0;min-width:0}
+.pick-set legend{padding:0;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3)}
+.pick__row{display:flex;flex-wrap:wrap;gap:.55rem .6rem;margin-top:.8rem}
+.pick{position:relative;display:inline-block}
+.pick input{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:pointer}
+.pick span{display:inline-block;padding:.62em 1.05em;border:1px solid var(--ink-3);border-radius:var(--radius);background:transparent;
+  font-size:.95rem;line-height:1.3;color:var(--ink);transition:background .25s var(--ease),color .25s var(--ease),border-color .25s var(--ease)}
+.pick:hover span{border-color:var(--ink)}
+.pick input:checked+span{background:var(--ink);border-color:var(--ink);color:var(--paper)}
+.pick input:focus-visible+span{outline:2px solid var(--crimson);outline-offset:3px}
+/* sending state — site.css has no disabled button, so it is defined here */
+.letter .btn{cursor:pointer}
+.letter .btn[disabled]{opacity:.55;cursor:progress;pointer-events:none}
+.letter .btn[disabled]::after{transform:none}
+/* success / error line under the button; kept in the DOM (empty) so screen readers announce changes */
+.form-msg:empty{margin:0}
+.form-msg{font-size:var(--s-0);line-height:1.45}
+.form-msg--err{margin-top:1rem}
+.form-msg .link{color:inherit}
+
+/* 5 · careers: open roles listed like a table of contents ------------------ */
+.roles{counter-reset:role;border-top:2px solid var(--ink)}
+.role{counter-increment:role;padding:clamp(1.4rem,3vw,2.2rem) 0;border-bottom:1px solid var(--rule)}
+.role__row{display:flex;align-items:baseline;gap:.9rem;color:var(--ink)}
+.role__row::before{content:counter(role);min-width:2.2rem;font-size:var(--s-1);font-style:italic;font-weight:700;color:var(--crimson)}
+.role__row::after{content:"";order:2;flex:1 1 2rem;min-width:1.2rem;border-bottom:2px dotted var(--rule);transform:translateY(-.3em);transition:border-color .2s}
+.role__title{font-size:var(--s-3);font-weight:700;letter-spacing:-.015em;line-height:1.08;color:var(--ink);transition:color .2s}
+.role__go{order:3;font-size:.76rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;color:var(--crimson)}
+.role__go::after{content:"\2192";display:inline-block;margin-left:.5em;letter-spacing:0;transition:transform .3s var(--ease)}
+.role__row:hover .role__title{color:var(--crimson)}
+.role__row:hover::after{border-color:var(--crimson)}
+.role__row:hover .role__go::after{transform:translateX(.3em)}
+.role__body{margin-top:1.1rem;padding-left:3.1rem;max-width:44rem}
+.role__text{color:var(--ink-2)}
+.role__body .tags{margin-top:1rem}
+.roles-note{margin-top:2rem;max-width:36em}
+
+/* 6 · small screens -------------------------------------------------------- */
+@media(max-width:560px){
+  .role__row::after{display:none}
+  .role__title{flex:1;font-size:var(--s-2)}
+  .role__body{padding-left:0}
+  .letter{padding:1.2rem 1rem 1.5rem}
+  .letter__head{font-size:.74rem}
+  .field--letter textarea{--lh:1.7rem}
+  .letter__send .btn{width:100%;justify-content:center}
+}
diff --git a/assets/js/pages/forms.js b/assets/js/pages/forms.js
new file mode 100644
index 0000000..c1c0c0f
--- /dev/null
+++ b/assets/js/pages/forms.js
@@ -0,0 +1,160 @@
+/* career.html · apply.html · contact.html — owned by S6.
+   Needs core.js (NEXT.$, NEXT.$$, NEXT.esc) and data/site.js (NEXT.site.email), loaded first.
+
+   What it does
+   - Sends both forms to Web3Forms exactly like the old pages did: POST https://api.web3forms.com/submit, FormData body,
+     Accept: application/json, success = data.success. The access key and every field name stay in the HTML.
+   - Checks required / email / link fields itself so each error sits under its field, is linked with aria-describedby,
+     and is summarised in a role="alert" line. (`novalidate` is set here, so without JS the browser's own checks still run.)
+   - Disables the button while sending, shows the owner's original success / error copy (data-ok / data-err on the form).
+   - apply.html: pre-fills the role from ?role=<slug>.
+   - Keeps the public email in one place (NEXT.site.email) for every [data-site-email] link. */
+(function () {
+  'use strict';
+  var NEXT = (window.NEXT = window.NEXT || {}), d = document, $ = NEXT.$, $$ = NEXT.$$, esc = NEXT.esc;
+  var ENDPOINT = 'https://api.web3forms.com/submit';
+  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
+  var mail = NEXT.site && NEXT.site.email;
+
+  /* ---- open roles ---------------------------------------------------------------------------------------
+     Only the role that already existed on the old career page. To add one: add an <li class="role"> to
+     career.html AND an entry here (apply.html reads this list). Request logged to move it to assets/data/roles.js. */
+  NEXT.roles = [
+    { slug: 'marketing-presentation-intern',
+      title: 'Marketing & Presentation Intern',
+      summary: 'Hybrid — Remote & Rajshahi · Internship with a path to full-time.',
+      text: 'Help shape how Next Inc. tells its story — building decks, pitch materials, and campaign content across our channels. You’ll work directly with the founding team, with a clear path to a full-time offer for the right person.',
+      tags: ['Hybrid — Remote & Rajshahi', 'Internship', 'Path to full-time'] }
+  ];
+
+  /* ---- small helpers ---- */
+  function syncShared() {
+    if (mail) $$('[data-site-email]').forEach(function (a) { a.textContent = mail; if (a.tagName === 'A') a.href = 'mailto:' + mail; });
+    $$('[data-today]').forEach(function (el) {
+      try { el.textContent = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }); } catch (x) {}
+    });
+  }
+  function titleHtml(t) {            /* last word of the role title is the crimson italic one */
+    var w = t.split(' '), last = w.pop();
+    return (w.length ? esc(w.join(' ')) + ' ' : '') + '<em>' + esc(last) + '</em>';
+  }
+
+  /* ---- apply.html: role from the query string ---- */
+  function initRole() {
+    var form = $('#apply-form'); if (!form) return;
+    var slug = ''; try { slug = new URLSearchParams(location.search).get('role') || ''; } catch (x) {}
+    var hit = NEXT.roles.filter(function (r) { return r.slug === slug; })[0], r = hit || NEXT.roles[0];
+
+    form.elements['role'].value = r.title;
+    form.elements['subject'].value = 'New Application: ' + r.title;
+    var h = $('[data-role-title]'); if (h) h.innerHTML = titleHtml(r.title);
+    $$('[data-role-short]').forEach(function (x) { x.textContent = r.title; });
+    var s = $('[data-role-summary]'); if (s) s.textContent = r.summary;
+    var t = $('[data-role-text]'); if (t) t.textContent = r.text;
+    var g = $('[data-role-tags]'); if (g) g.innerHTML = r.tags.map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('');
+    d.title = 'Apply — ' + r.title + ' — Next Inc.';
+
+    var note = $('#role-note');       /* a ?role= we do not know: say so instead of silently picking one */
+    if (note && slug && !hit) {
+      note.innerHTML = '<b>&dagger;</b> We could not match that role link, so this form is for <b>' + esc(r.title) + '</b>. <a class="link" href="career.html">See all open roles</a>.';
+      note.hidden = false;
+    }
+  }
+
+  /* ---- validation ---- */
+  var EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
+  function normUrl(v) {              /* "behance.net/me" -> "https://behance.net/me"; anything with a scheme is left alone */
+    v = v.trim();
+    if (/^[a-z][a-z0-9+.\-]*:/i.test(v)) return v;
+    return /^[^\s]+\.[^\s]{2,}$/.test(v) ? 'https://' + v : v;
+  }
+  function validUrl(v) { try { return /^https?:$/.test(new URL(v).protocol); } catch (x) { return false; } }
+  function check(inp) {
+    var v = (inp.value || '').trim();
+    if (inp.required && !v) return inp.getAttribute('data-required') || 'Please fill this in.';
+    if (v && inp.type === 'email' && !EMAIL.test(v)) return 'That does not look like an email address.';
+    if (v && inp.type === 'url' && !validUrl(normUrl(v))) return 'Please enter a link, for example https://example.com.';
+    return '';
+  }
+  function labelOf(field) {
+    var sp = field.querySelector('span'); return sp ? (sp.childNodes[0] ? sp.childNodes[0].textContent : sp.textContent).trim() : '';
+  }
+  function describe(inp, id, on) {
+    var ids = (inp.getAttribute('aria-describedby') || '').split(/\s+/).filter(function (x) { return x && x !== id; });
+    if (on) ids.push(id);
+    if (ids.length) inp.setAttribute('aria-describedby', ids.join(' ')); else inp.removeAttribute('aria-describedby');
+  }
+  function mark(field, inp, msg) {
+    var id = inp.id + '-err', err = d.getElementById(id);
+    if (!msg) {
+      if (err) err.remove();
+      field.classList.remove('is-invalid'); inp.removeAttribute('aria-invalid'); describe(inp, id, false); return;
+    }
+    if (!err) { err = d.createElement('p'); err.className = 'field__err'; err.id = id; field.parentNode.insertBefore(err, field.nextSibling); }
+    err.textContent = msg; field.classList.add('is-invalid'); inp.setAttribute('aria-invalid', 'true'); describe(inp, id, true);
+  }
+  function fieldsOf(form) {
+    return $$('.field', form).map(function (f) { return { f: f, i: $('input,textarea,select', f) }; }).filter(function (x) { return x.i; });
+  }
+
+  /* ---- form engine ---- */
+  function initForm(form) {
+    var btn = $('[type="submit"]', form), ok = $('.form-msg--ok', form), bad = $('.form-msg--err', form);
+    if (!btn || !ok || !bad) return;
+    var label = btn.textContent;
+    form.noValidate = true;
+
+    function say(kind, text) {
+      ok.textContent = ''; bad.textContent = '';
+      if (kind === 'ok') ok.textContent = text;
+      else if (kind === 'fail') bad.innerHTML = esc(text) + (mail ? ' at <a class="link" href="mailto:' + esc(mail) + '">' + esc(mail) + '</a>' : '') + '.';
+      else if (kind === 'check') bad.textContent = text;
+      if (kind !== 'clear' && !reduce) { try { (kind === 'ok' ? ok : bad).scrollIntoView({ block: 'nearest', behavior: 'smooth' }); } catch (x) {} }
+    }
+    function clearAll() { fieldsOf(form).forEach(function (x) { mark(x.f, x.i, ''); }); say('clear'); }
+
+    /* fix a field as soon as the visitor fixes the text */
+    function recheck(ev) {
+      var f = ev.target.closest && ev.target.closest('.field'); if (!f || !f.classList.contains('is-invalid')) return;
+      var inp = $('input,textarea,select', f); if (!inp) return;
+      mark(f, inp, check(inp));
+      if (!$('.is-invalid', form)) bad.textContent = '';
+    }
+    form.addEventListener('input', recheck); form.addEventListener('change', recheck);
+
+    form.addEventListener('submit', function (ev) {
+      ev.preventDefault();
+      if (form.getAttribute('aria-busy') === 'true') return;
+      ok.textContent = ''; bad.textContent = '';
+
+      var first = null, names = [];
+      fieldsOf(form).forEach(function (x) {
+        var msg = check(x.i); mark(x.f, x.i, msg);
+        if (msg) { names.push(labelOf(x.f)); if (!first) first = x.i; }
+      });
+      if (first) { say('check', 'Please check ' + (names.length === 1 ? 'this field' : 'these fields') + ': ' + names.join(', ') + '.'); first.focus(); return; }
+
+      /* the copy that is sent — the visible inputs are never rewritten */
+      var fd = new FormData(form);
+      $$('input[type="url"]', form).forEach(function (u) { if (u.value.trim()) fd.set(u.name, normUrl(u.value)); });
+      if (form.hasAttribute('data-subject') && !String(fd.get('subject') || '').trim()) {
+        var kind = fd.get('project_type'); fd.set('subject', form.getAttribute('data-subject') + (kind ? ' — ' + kind : ''));
+      }
+      if (fd.has('budget') && !String(fd.get('budget')).trim()) fd.delete('budget');
+
+      btn.disabled = true; btn.textContent = form.getAttribute('data-sending') || 'Sending…'; form.setAttribute('aria-busy', 'true');
+      fetch(ENDPOINT, { method: 'POST', headers: { 'Accept': 'application/json' }, body: fd })
+        .then(function (res) { return res.json(); })
+        .then(function (data) {
+          if (data && data.success) { form.reset(); clearAll(); say('ok', form.getAttribute('data-ok') || 'Thank you.'); }
+          else say('fail', form.getAttribute('data-err') || 'Something went wrong. Please try again or email us directly');
+        })
+        .catch(function () { say('fail', form.getAttribute('data-err') || 'Something went wrong. Please try again or email us directly'); })
+        .then(function () { btn.disabled = false; btn.textContent = label; form.removeAttribute('aria-busy'); });
+    });
+  }
+
+  /* Runs right away (this script sits at the end of <body>), i.e. before core.js splits the headline into words —
+     so the role title written by initRole() still gets the word-rise. */
+  syncShared(); initRole(); $$('form[data-form]').forEach(initForm);
+})();

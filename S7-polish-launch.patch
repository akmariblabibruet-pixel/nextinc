+++ b/scripts/brand/make-brand.mjs
@@ -0,0 +1,82 @@
+#!/usr/bin/env node
+/* Regenerates the brand files: SVG favicon (+ dark variant), PNG icons, favicon.ico, web manifest, 1200x630 OG card.
+ * Not part of the site itself. Needs two dev-only packages the site does not use:
+ *     npm i --no-save playwright sharp        (and a Chromium: `npx playwright install chromium`)
+ * If they live elsewhere, point BRAND_TOOLS at that folder (the one that contains node_modules).
+ *     node scripts/brand/make-brand.mjs          (CHROMIUM_PATH=/path/to/chrome to use a specific browser binary)
+ * The crimson italic x is the glyph outline of "x" from assets/fonts/cmu-serif-700-italic.woff2, stored in glyph-x.json. Owned by S7. */
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
+const req = createRequire(join(process.env.BRAND_TOOLS || root, 'package.json'));
+const sharp = req('sharp'), { chromium } = req('playwright');
+
+const g = JSON.parse(readFileSync(join(dirname(fileURLToPath(import.meta.url)), 'glyph-x.json'), 'utf8'));
+const sb = {}; sb.window = sb; (await import('node:vm')).runInNewContext(readFileSync(join(root, 'assets/data/site.js'), 'utf8'), sb);
+const site = sb.NEXT.site;
+const C = { paper: '#F5F0E6', ink: '#16120E', crimson: '#C0102C', crimsonHi: '#FF4660' };
+
+/* x glyph centred in a box of `size`, filling `fill` of it (font units are y-up, so flip) */
+function glyph(size, fill, colour) {
+  const [x0, y0, x1, y1] = g.bounds, w = x1 - x0, h = y1 - y0, s = (size * fill) / Math.max(w, h);
+  const tx = (size - w * s) / 2 - x0 * s, ty = (size + h * s) / 2 + y0 * s;
+  return `<path fill="${colour}" transform="translate(${tx.toFixed(2)} ${ty.toFixed(2)}) scale(${s.toFixed(5)} ${(-s).toFixed(5)})" d="${g.d}"/>`;
+}
+const iconSvg = (size, fill, bg, fg, radius = 0.22) =>
+  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${size}" width="${size}" height="${size}"><rect width="${size}" height="${size}" rx="${size * radius}" fill="${bg}"/>${glyph(size, fill, fg)}</svg>`;
+
+const out = (p) => { mkdirSync(dirname(join(root, p)), { recursive: true }); return join(root, p); };
+
+/* 1. SVG favicon: crimson x on paper; dark scheme gets ink with the lighter crimson */
+const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><style>.bg{fill:${C.paper}}.x{fill:${C.crimson}}@media (prefers-color-scheme:dark){.bg{fill:${C.ink}}.x{fill:${C.crimsonHi}}}</style><rect class="bg" width="64" height="64" rx="14"/>${glyph(64, 0.62, C.crimson).replace('fill="' + C.crimson + '"', 'class="x"')}</svg>\n`;
+writeFileSync(out('assets/img/icons/icon.svg'), svg);
+
+/* 2. PNG icons */
+const png = async (file, size, fill, radius) => sharp(Buffer.from(iconSvg(size, fill, C.paper, C.crimson, radius))).png({ compressionLevel: 9, palette: true }).toFile(out(file));
+await png('assets/img/icons/icon-192.png', 192, 0.62, 0.22);
+await png('assets/img/icons/icon-512.png', 512, 0.62, 0.22);
+await png('assets/img/icons/apple-touch-icon.png', 180, 0.62, 0);          // iOS rounds the corners itself
+await png('assets/img/icons/icon-maskable-512.png', 512, 0.46, 0);         // full bleed; glyph kept inside the 80% safe zone
+
+/* 3. favicon.ico (one 48x48 PNG image inside an ICO container) */
+const p48 = await sharp(Buffer.from(iconSvg(48, 0.66, C.paper, C.crimson, 0.2))).png({ compressionLevel: 9 }).toBuffer();
+const head = Buffer.alloc(22); head.writeUInt16LE(0, 0); head.writeUInt16LE(1, 2); head.writeUInt16LE(1, 4);
+head[6] = 48; head[7] = 48; head.writeUInt16LE(1, 10); head.writeUInt16LE(32, 12); head.writeUInt32LE(p48.length, 14); head.writeUInt32LE(22, 18);
+writeFileSync(out('favicon.ico'), Buffer.concat([head, p48]));
+
+/* 4. manifest */
+writeFileSync(out('site.webmanifest'), JSON.stringify({
+  name: site.name, short_name: 'Next Inc.', description: site.tagline, start_url: './', scope: './', display: 'browser',
+  background_color: C.paper, theme_color: C.paper,
+  icons: [
+    { src: 'assets/img/icons/icon-192.png', sizes: '192x192', type: 'image/png' },
+    { src: 'assets/img/icons/icon-512.png', sizes: '512x512', type: 'image/png' },
+    { src: 'assets/img/icons/icon-maskable-512.png', sizes: '512x512', type: 'image/png', purpose: 'maskable' }
+  ]
+}, null, 2) + '\n');
+
+/* 5. OG card: typeset in the site's own fonts, rendered in Chromium. No date on it, so it never goes stale. */
+const font = (f) => 'data:font/woff2;base64,' + readFileSync(join(root, 'assets/fonts', f)).toString('base64');   // inlined: a page set via setContent cannot load file:// fonts
+const html = `<!doctype html><meta charset="utf-8"><style>
+@font-face{font-family:C;font-weight:700;font-style:normal;src:url(${font('cmu-serif-700-roman.woff2')})}
+@font-face{font-family:C;font-weight:700;font-style:italic;src:url(${font('cmu-serif-700-italic.woff2')})}
+@font-face{font-family:C;font-weight:500;font-style:normal;src:url(${font('cmu-serif-500-roman.woff2')})}
+@font-face{font-family:C;font-weight:500;font-style:italic;src:url(${font('cmu-serif-500-italic.woff2')})}
+*{margin:0;box-sizing:border-box}body{width:1200px;height:630px;background:${C.paper};color:${C.ink};font-family:C,Georgia,serif;position:relative;overflow:hidden}
+.frame{position:absolute;inset:36px;border:2px solid ${C.ink}}
+.k{position:absolute;left:92px;top:84px;font-size:22px;letter-spacing:.14em;text-transform:uppercase;color:#6B6254;font-weight:700}
+.w{position:absolute;left:88px;top:148px;font-size:188px;line-height:1;font-weight:700;letter-spacing:-.03em}.w i{color:${C.crimson}}.w small{font-size:62px;font-weight:500;letter-spacing:0;margin-left:.2em}
+.t{position:absolute;left:92px;top:366px;width:900px;font-size:54px;line-height:1.18;font-weight:500;font-style:italic;text-wrap:balance}
+.d{position:absolute;left:92px;bottom:72px;font-size:28px;color:#6B6254;font-weight:500}
+.rule{position:absolute;left:92px;top:338px;width:120px;height:4px;background:${C.crimson}}
+</style><body><div class="frame"></div><div class="k">Innovation lab · Full-stack technology partner</div>
+<div class="w">Ne<i>x</i>t<small>Inc.</small></div><div class="rule"></div>
+<div class="t">${site.tagline}</div><div class="d">${new URL(site.url).hostname}</div></body>`;
+const browser = await chromium.launch(process.env.CHROMIUM_PATH ? { executablePath: process.env.CHROMIUM_PATH } : {}); const page = await browser.newPage({ viewport: { width: 1200, height: 630 } });
+await page.setContent(html); await page.evaluate(() => document.fonts.ready); await page.waitForTimeout(200);
+const shot = await page.screenshot({ type: 'png' }); await browser.close();
+await sharp(shot).png({ compressionLevel: 9, palette: true, colours: 64 }).toFile(out('assets/img/og/og-default.png'));
+console.log('brand files written');
diff --git a/scripts/check-launch.mjs b/scripts/check-launch.mjs
new file mode 100644
index 0000000..8d658ec
--- /dev/null
+++ b/scripts/check-launch.mjs
@@ -0,0 +1,87 @@
+#!/usr/bin/env node
+/* Launch gate (part of `npm run prelaunch`). Fails (exit 1) on anything that would embarrass us on day one:
+ *   - the public address is still the placeholder
+ *   - a public page lacks a unique title/description, canonical link or social card; the OG image is missing or not 1200x630
+ *   - favicon / manifest / robots / sitemap / 404 files are missing or broken
+ *   - a local link, script, stylesheet, image or data-file path points at a file that does not exist
+ *   - one of the old unverified claims or template leftovers is still on the site (8.9 ms, 99.99x %, "hundreds", "award winning",
+ *     FundedNext, "trading", Tailwind CDN, Google Fonts, Material Symbols)
+ * Warnings (title/description length, images without alt) are printed but do not fail. Owned by S7. */
+import { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join, relative, extname } from 'node:path';
+import vm from 'node:vm';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const fails = [], warns = [];
+const fail = (m) => fails.push(m), warn = (m) => warns.push(m);
+const read = (f) => readFileSync(join(root, f), 'utf8');
+const walk = (dir, out = []) => { for (const f of readdirSync(join(root, dir))) { const p = join(dir, f); statSync(join(root, p)).isDirectory() ? walk(p, out) : out.push(p); } return out; };
+
+/* ---- 1. public address ---- */
+const sb = {}; sb.window = sb; vm.runInNewContext(read('assets/data/site.js'), sb);
+const site = sb.NEXT.site; let host = '';
+try { host = new URL(site.url).hostname; } catch { /* handled below */ }
+if (!site.url || !/^https:\/\//.test(site.url)) fail('assets/data/site.js: site.url must be the live https address (then run `npm run sync`).');
+else if (/^(www\.)?example\.(com|org|net)$/.test(host) || /localhost|127\.0\.0\.1/.test(host)) fail(`assets/data/site.js: site.url is still the placeholder (${site.url}). Set the real address, then run \`npm run sync\`.`);
+
+/* ---- 2. public pages ---- */
+const pages = readdirSync(root).filter((f) => f.endsWith('.html')).sort();
+const seen = { title: new Map(), desc: new Map() };
+for (const f of pages) {
+  const s = read(f); if (!s.includes('<!-- seo -->') || /<meta name="robots" content="noindex"/.test(s) || ['styleguide.html', '404.html'].includes(f)) continue;
+  const title = (s.match(/<title>([\s\S]*?)<\/title>/) || [])[1], desc = (s.match(/<meta name="description" content="([^"]*)"/) || [])[1];
+  if (!title) fail(`${f}: no <title>`); else { if (title.length > 70) warn(`${f}: title is ${title.length} chars (search results cut at about 60)`); (seen.title.get(title) || seen.title.set(title, []).get(title)).push(f); }
+  if (!desc) fail(`${f}: no meta description`); else { if (desc.length < 70 || desc.length > 160) warn(`${f}: description is ${desc.length} chars (aim for 70–160)`); (seen.desc.get(desc) || seen.desc.set(desc, []).get(desc)).push(f); }
+  for (const [needle, what] of [['rel="canonical"', 'canonical link'], ['property="og:image"', 'og:image'], ['property="og:title"', 'og:title'], ['name="twitter:card"', 'twitter:card']])
+    if (!s.includes(needle)) fail(`${f}: missing ${what} (run \`npm run sync\`)`);
+}
+for (const [k, m] of Object.entries(seen)) for (const [v, files] of m) if (files.length > 1) fail(`${files.join(', ')}: identical ${k} — each page needs its own`);
+
+/* ---- 3. brand + crawler files ---- */
+const must = ['favicon.ico', 'assets/img/icons/icon.svg', 'assets/img/icons/apple-touch-icon.png', 'assets/img/icons/icon-192.png', 'assets/img/icons/icon-512.png', 'assets/img/icons/icon-maskable-512.png', 'assets/img/og/og-default.png', 'site.webmanifest', 'robots.txt', 'sitemap.xml', '404.html'];
+for (const f of must) if (!existsSync(join(root, f))) fail(`missing file: ${f}`);
+if (existsSync(join(root, 'assets/img/og/og-default.png'))) {
+  const b = readFileSync(join(root, 'assets/img/og/og-default.png')); const w = b.readUInt32BE(16), h = b.readUInt32BE(20);
+  if (w !== 1200 || h !== 630) fail(`assets/img/og/og-default.png is ${w}x${h}, must be 1200x630`);
+  if (b.length > 300 * 1024) warn(`og-default.png is ${(b.length / 1024) | 0} KB (keep it under 300 KB; some networks drop larger cards)`);
+}
+try { const m = JSON.parse(read('site.webmanifest')); for (const i of m.icons || []) if (!existsSync(join(root, i.src))) fail(`site.webmanifest: icon not found: ${i.src}`); } catch (e) { fail(`site.webmanifest is not valid JSON (${e.message})`); }
+if (existsSync(join(root, 'robots.txt')) && !/^Sitemap: https:\/\//m.test(read('robots.txt'))) fail('robots.txt has no absolute Sitemap line');
+
+/* ---- 4. local references exist ---- */
+const refOk = (from, ref) => {
+  if (!ref || /^(https?:|mailto:|tel:|data:|#|javascript:)/.test(ref)) return true;
+  const clean = ref.split('#')[0].split('?')[0]; if (!clean) return true;
+  return existsSync(join(root, dirname(from), clean));
+};
+for (const f of pages) {
+  const s = read(f);
+  for (const m of s.matchAll(/(?:href|src|srcset)="([^"]+)"/g)) { if (m[1].includes('{')) continue; if (!refOk(f, m[1].split(/\s+/)[0])) fail(`${f}: broken reference "${m[1]}"`); }
+  for (const m of s.matchAll(/<img\b[^>]*>/g)) if (!/\balt=/.test(m[0])) warn(`${f}: <img> without alt`);
+}
+for (const f of walk('assets/data').filter((x) => x.endsWith('.js'))) {
+  for (const m of read(f).matchAll(/["'](assets\/[^"']+\.(?:png|jpe?g|webp|svg|gif|mp4|webm|woff2?))["']/g)) if (!existsSync(join(root, m[1]))) fail(`${f}: file not found "${m[1]}"`);
+}
+for (const f of walk('assets/css').filter((x) => x.endsWith('.css'))) {
+  for (const m of read(f).matchAll(/url\(["']?([^"')]+)["']?\)/g)) if (!/^(data:|https?:|#|%23)/.test(m[1]) && !existsSync(join(root, dirname(f), m[1].split(/[?#]/)[0]))) fail(`${f}: url() not found "${m[1]}"`);
+}
+
+/* ---- 5. old claims and template leftovers (site files only — docs and ledgers talk about them on purpose) ---- */
+const banned = [[/\b8\.9\s*ms\b/i, '"8.9 ms" latency claim'], [/99\.99\d*\s*%?/, '"99.99x%" uptime/SLA claim'], [/trusted by hundreds|hundreds of (?:clients|companies|customers|teams)/i, '"hundreds" claim'],
+  [/award[- ]winning/i, '"award winning" claim'], [/fundednext/i, 'FundedNext (old template)'], [/\btrading\b/i, '"trading" (old template wording)'], [/institutional/i, '"institutional" (old template wording)'],
+  [/cdn\.tailwindcss\.com/i, 'Tailwind CDN'], [/fonts\.googleapis\.com|fonts\.gstatic\.com/i, 'Google Fonts'], [/material[- ]symbols/i, 'Material Symbols']];
+const siteFiles = [...pages, ...walk('assets').filter((f) => /\.(js|css|html|json)$/.test(f)), 'site.webmanifest', 'robots.txt', 'sitemap.xml'];
+for (const f of siteFiles) { const s = read(f); for (const [re, what] of banned) if (re.test(s)) fail(`${f}: ${what}`); }
+
+/* ---- report ---- */
+if (warns.length) console.log('Warnings:\n' + warns.map((w) => `  ! ${w}`).join('\n') + '\n');
+if (fails.length) { console.error('Launch gate FAILED:\n' + fails.map((m) => `  ✗ ${m}`).join('\n')); process.exit(1); }
+console.log(`Launch gate passed (${pages.length} pages checked).`);
+console.log([
+  '\nStill to do by hand (cannot be checked from here):',
+  '  1. Web3Forms dashboard → restrict the access key to the production domain.',
+  '  2. Send one real test message from contact.html and one from apply.html on the live domain.',
+  '  3. Confirm the public email on the site is the one you want.',
+  '  4. Deploy only the site files (index/pages, assets/, favicon.ico, site.webmanifest, robots.txt, sitemap.xml, 404.html) — not docs/, ledger/, scripts/, patches/.'
+].join('\n'));
diff --git a/scripts/sync-site.mjs b/scripts/sync-site.mjs
new file mode 100644
index 0000000..3061b7f
--- /dev/null
+++ b/scripts/sync-site.mjs
@@ -0,0 +1,132 @@
+#!/usr/bin/env node
+/* Derived site files: everything that depends on the public address or on a data file.
+ *   node scripts/sync-site.mjs          rewrite the files
+ *   node scripts/sync-site.mjs --check  exit 1 if any file is out of date
+ * Source of truth: NEXT.site.url (assets/data/site.js) · NEXT.projects · NEXT.team · NEXT.roles.
+ * SITE_URL=https://example.org node scripts/sync-site.mjs   overrides the address for one run (testing).
+ *
+ * Writes
+ *   <!-- seo -->…<!-- /seo -->        in each page's <head>: canonical, icons, manifest, Open Graph, Twitter card
+ *                                     (+ Organization JSON-LD on index.html). Pages get it by containing the marker pair.
+ *   <!-- seo:base -->…<!-- /seo:base --> 404.html only: makes its relative links work from any missing address.
+ *   <!-- roles -->…<!-- /roles -->    career.html: the open-roles list, from assets/data/roles.js
+ *   sitemap.xml, robots.txt
+ * Titles and descriptions are read from each page's own <title> / <meta name="description"> — edit them there.
+ * Owned by S7. */
+import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+import vm from 'node:vm';
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const check = process.argv.includes('--check');
+
+/* ---- data: evaluate the browser data files in a sandbox ---- */
+function load(file) {
+  const sb = {}; sb.window = sb; vm.runInNewContext(readFileSync(join(root, 'assets/data', file), 'utf8'), sb);
+  return sb.NEXT;
+}
+const N = { ...load('site.js'), ...load('projects.js'), ...load('team.js'), ...load('roles.js') };
+const site = N.site;
+const url = (process.env.SITE_URL || site.url || '').replace(/\/+$/, '');
+const basePath = (() => { try { return new URL(url).pathname.replace(/\/?$/, '/'); } catch { return '/'; } })();
+const abs = (p) => url + '/' + p.replace(/^\//, '');
+
+const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
+const attr = (s) => s;                       // already-escaped HTML read from a page is reused as is
+const OG = { path: 'assets/img/og/og-default.png', w: 1200, h: 630 };
+const alt = `${site.name} — ${site.tagline}`;
+
+/* pages: kind 'full' = canonical + social cards, 'icons' = icons only (noindex pages). Anything else is skipped. */
+const kind = { '404.html': 'icons', 'styleguide.html': 'icons' };
+const noSitemap = new Set(['404.html', 'styleguide.html', 'products.html', 'project.html']);   // project.html is a template: each real project is listed as project.html?p=<slug>
+const order = ['index.html', 'work.html', 'films.html', 'studio.html', 'recognition.html', 'career.html', 'apply.html', 'contact.html'];
+
+const icons = [
+  '<link rel="icon" href="favicon.ico" sizes="48x48">',
+  '<link rel="icon" href="assets/img/icons/icon.svg" type="image/svg+xml" sizes="any">',
+  '<link rel="apple-touch-icon" href="assets/img/icons/apple-touch-icon.png">',
+  '<link rel="manifest" href="site.webmanifest">'
+];
+
+function jsonLd() {
+  const o = {
+    '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: url + '/', slogan: site.tagline, description: site.blurb,
+    logo: abs('assets/img/icons/icon-512.png'), email: site.email,
+    location: (site.hubs || []).map((h) => ({ '@type': 'Place', name: h.name, address: h.name })),
+    founder: (N.team || []).map((t) => ({ '@type': 'Person', name: t.name, jobTitle: t.role }))
+  };
+  return '<script type="application/ld+json">\n' + JSON.stringify(o, null, 2).replace(/</g, '\\u003c') + '\n</script>';
+}
+
+function seoBlock(file, src) {
+  const lines = [];
+  if (kind[file] !== 'icons') {
+    const title = (src.match(/<title>([\s\S]*?)<\/title>/) || [])[1] || '', desc = (src.match(/<meta name="description" content="([^"]*)"/) || [])[1] || '';
+    const canon = file === 'index.html' ? url + '/' : abs(file);
+    lines.push(`<link rel="canonical" href="${canon}">`);
+    lines.push(...icons);
+    lines.push('<meta property="og:type" content="website">', `<meta property="og:site_name" content="${esc(site.name)}">`, '<meta property="og:locale" content="en_US">',
+      `<meta property="og:title" content="${attr(title)}">`, `<meta property="og:description" content="${attr(desc)}">`, `<meta property="og:url" content="${canon}">`,
+      `<meta property="og:image" content="${abs(OG.path)}">`, `<meta property="og:image:width" content="${OG.w}">`, `<meta property="og:image:height" content="${OG.h}">`, `<meta property="og:image:alt" content="${esc(alt)}">`,
+      '<meta name="twitter:card" content="summary_large_image">', `<meta name="twitter:title" content="${attr(title)}">`, `<meta name="twitter:description" content="${attr(desc)}">`,
+      `<meta name="twitter:image" content="${abs(OG.path)}">`, `<meta name="twitter:image:alt" content="${esc(alt)}">`);
+    if (file === 'index.html') lines.push(jsonLd());
+  } else lines.push(...icons);
+  return lines.join('\n');
+}
+
+/* 404.html is served for any missing address (/a/b/c), where "assets/…" would not resolve. A base element fixes that,
+   but only when the page is not being opened at its own address (so local previews keep working). */
+const baseBlock = () => `<script>(function(){if(/404\\.html$/.test(location.pathname))return;var b=document.createElement('base');b.href=${JSON.stringify(basePath)};document.head.appendChild(b);})();</script>`;
+
+function rolesBlock() {
+  return (N.roles || []).map((r) => `      <li class="role" id="${esc(r.slug)}" data-reveal>
+        <a class="role__row" href="apply.html?role=${esc(r.slug)}">
+          <span class="role__title">${esc(r.title)}</span>
+          <span class="role__go">Apply</span>
+        </a>
+        <div class="role__body">
+          <p class="role__text">${esc(r.text)}</p>
+          <ul class="tags">
+${(r.tags || []).map((t) => `            <li>${esc(t)}</li>`).join('\n')}
+          </ul>
+        </div>
+      </li>`).join('\n');
+}
+
+const swap = (src, name, body) => {
+  const re = new RegExp(`<!-- ${name} -->[\\s\\S]*?<!-- /${name} -->`);
+  return re.test(src) ? src.replace(re, () => `<!-- ${name} -->\n${body}\n<!-- /${name} -->`) : src;
+};
+
+let stale = 0;
+const touch = (name, next, prev) => {
+  if (next === prev) { console.log(`ok     ${name}`); return; }
+  stale++;
+  if (check) console.log(`STALE  ${name}`); else { writeFileSync(join(root, name), next); console.log(`synced ${name}`); }
+};
+
+const pages = readdirSync(root).filter((f) => f.endsWith('.html')).sort();
+for (const file of pages) {
+  const prev = readFileSync(join(root, file), 'utf8');
+  if (!prev.includes('<!-- seo -->')) { console.log(`skip   ${file} (no seo marker)`); continue; }
+  let next = swap(prev, 'seo', seoBlock(file, prev));
+  if (file === '404.html') next = swap(next, 'seo:base', baseBlock());
+  if (file === 'career.html') next = swap(next, 'roles', rolesBlock());
+  touch(file, next, prev);
+}
+
+/* ---- sitemap.xml ---- */
+const urls = pages.filter((f) => !noSitemap.has(f) && readFileSync(join(root, f), 'utf8').includes('<!-- seo -->')).sort((a, b) => (order.indexOf(a) + 1 || 99) - (order.indexOf(b) + 1 || 99) || a.localeCompare(b)).map((f) => (f === 'index.html' ? url + '/' : abs(f)));
+const projects = (N.projects || []).filter((p) => !p.sample).map((p) => abs(`project.html?p=${encodeURIComponent(p.slug)}`));
+const sitemap = '<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n' +
+  [...urls, ...projects].map((u) => `  <url><loc>${esc(u)}</loc></url>`).join('\n') + '\n</urlset>\n';
+const read = (f) => { try { return readFileSync(join(root, f), 'utf8'); } catch { return ''; } };
+touch('sitemap.xml', sitemap, read('sitemap.xml'));
+
+/* ---- robots.txt: crawl everything on the site; keep crawlers out of the project's working files if they get deployed ---- */
+const robots = `User-agent: *\nAllow: /\n${['docs', 'ledger', 'scripts', 'patches'].map((d) => `Disallow: ${basePath}${d}/`).join('\n')}\n\nSitemap: ${abs('sitemap.xml')}\n`;
+touch('robots.txt', robots, read('robots.txt'));
+
+if (check && stale) { console.error(`\n${stale} file(s) out of date — run: node scripts/sync-site.mjs`); process.exit(1); }

@@ -0,0 +1,19 @@
+#!/usr/bin/env node
+/* Pre-launch guard. Lists every placeholder left in the site.
+ *   node scripts/check-samples.mjs          report (exit 0)
+ *   node scripts/check-samples.mjs --strict exit 1 if anything is left (use before publishing). Owned by S1. */
+import { readFileSync, readdirSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+let n = 0;
+const hit = (where, what) => { n++; console.log(`  • ${where}: ${what}`); };
+for (const f of readdirSync(join(root, 'assets/data')).filter((x) => x.endsWith('.js') && x !== 'world.js')) {
+  readFileSync(join(root, 'assets/data', f), 'utf8').split('\n').forEach((l, i) => { if (/sample:\s*true/.test(l)) hit(`assets/data/${f}:${i + 1}`, l.trim().slice(0, 70)); });
+}
+for (const f of readdirSync(root).filter((x) => x.endsWith('.html'))) {
+  const s = readFileSync(join(root, f), 'utf8'); const m = s.match(/<!-- STUB:(S\d)/);
+  if (m) hit(f, `still a stub for stage ${m[1]}`);
+}
+console.log(n ? `\n${n} placeholder(s) left before launch.` : '\nNo placeholders left. Ready to publish.');
+if (n && process.argv.includes('--strict')) process.exit(1);
diff --git a/scripts/ledger.mjs b/scripts/ledger.mjs
new file mode 100644
index 0000000..ac5192e
--- /dev/null
+++ b/scripts/ledger.mjs
@@ -0,0 +1,20 @@
+#!/usr/bin/env node
+/* Rebuilds LEDGER.md from ledger/S*.md (one file per stage — so parallel patches never conflict).
+ *   node scripts/ledger.mjs
+ * Each ledger/S*.md starts with front-matter:  status: pending | in-progress | done  and  owner: <who>. Owned by S1. */
+import { readFileSync, writeFileSync, readdirSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+const root = join(dirname(fileURLToPath(import.meta.url)), '..');
+const dir = join(root, 'ledger');
+const files = readdirSync(dir).filter((f) => /^S\d+.*\.md$/.test(f)).sort();
+const meta = (src, k) => (src.match(new RegExp(`^${k}:\\s*(.*)$`, 'm')) || [, ''])[1].trim();
+const icon = { done: '✅', 'in-progress': '🟡', pending: '⬜' };
+let table = '| Stage | Name | Status | Owner | Depends on |\n|---|---|---|---|---|\n', body = '';
+for (const f of files) {
+  const s = readFileSync(join(dir, f), 'utf8'), st = meta(s, 'status') || 'pending';
+  table += `| ${meta(s, 'stage')} | ${meta(s, 'name')} | ${icon[st] || ''} ${st} | ${meta(s, 'owner') || '—'} | ${meta(s, 'depends') || '—'} |\n`;
+  body += `\n---\n\n${s.replace(/^---[\s\S]*?---\n/, '')}`;
+}
+writeFileSync(join(root, 'LEDGER.md'), `# LEDGER — generated, do not edit\n\nRegenerate with \`node scripts/ledger.mjs\`. Edit the per-stage files in \`ledger/\` instead.\n\n${table}${body}`);
+console.log(`LEDGER.md rebuilt from ${files.length} stage files`);

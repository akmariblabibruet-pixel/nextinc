diff --git a/.githooks/commit-msg b/.githooks/commit-msg
new file mode 100755
index 0000000..4d6c593
--- /dev/null
+++ b/.githooks/commit-msg
@@ -0,0 +1,20 @@
+#!/bin/sh
+# commit-msg: strips AI-tool attribution (Co-authored-by trailers, "Generated with"
+# footers, session links) from the commit message. Enable once per clone: npm run hooks
+msg_file="$1"
+tmp="$(mktemp)" || exit 0
+
+awk '
+  BEGIN { ai = "claude|anthropic|copilot|chatgpt|openai|gemini|cursoragent|codeium|windsurf|devin-ai|swe-agent" }
+  { l = tolower($0) }
+  NR > 1 && l ~ ("^[ \t]*(co-authored-by|assisted-by|generated-by|reviewed-by|signed-off-by)[ \t]*:.*(" ai ")") { next }
+  NR > 1 && l ~ /^[ \t]*claude-session[ \t]*:/ { next }
+  NR > 1 && l ~ /^[^a-z0-9]*(generated|created|written|assisted)[ \t]+(with|by)[^a-z]*(claude|copilot|chatgpt|gemini)/ { next }
+  NF { for (i = 0; i < blank; i++) print ""; blank = 0; print; next }
+  { blank++ }
+' "$msg_file" > "$tmp"
+
+# never leave an empty message behind
+if [ -s "$tmp" ]; then cat "$tmp" > "$msg_file"; fi
+rm -f "$tmp"
+exit 0
diff --git a/.githooks/pre-push b/.githooks/pre-push
new file mode 100755
index 0000000..6d5dbf6
--- /dev/null
+++ b/.githooks/pre-push
@@ -0,0 +1,15 @@
+#!/bin/sh
+# pre-push: blocks the push if any outgoing commit carries AI-tool attribution.
+# Catches trailers that editors add AFTER the commit is created (the commit-msg hook can't).
+command -v node >/dev/null 2>&1 || { echo "pre-push: node not found, skipping attribution check"; exit 0; }
+zero=0000000000000000000000000000000000000000
+while read -r local_ref local_sha remote_ref remote_sha; do
+  [ "$local_sha" = "$zero" ] && continue
+  if [ "$remote_sha" = "$zero" ]; then
+    set -- "$local_sha" --not --remotes
+  else
+    set -- "$remote_sha..$local_sha"
+  fi
+  node scripts/check-attribution.mjs "$@" || exit 1
+done
+exit 0

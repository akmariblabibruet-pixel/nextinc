+  NEXT.$$ = function (s, c) { return Array.prototype.slice.call((c || d).querySelectorAll(s)); };
+
+  /* ---- header: hairline once scrolled, hides on scroll-down, returns on scroll-up */
+  function initHeader() {
+    var h = NEXT.$('.site-header'); if (!h) return;
